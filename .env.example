# Accounts are paused. Default guest play needs no secrets or database.
ENABLE_ACCOUNTS=false
VITE_ENABLE_ACCOUNTS=false

# To resume account work later, explicitly enable BOTH flags and configure:
# LOCAL_DATABASE_PATH=/tmp/living-world-development.sqlite  # development only
# DATABASE_URL=your private Postgres connection URL        # production server only
# APP_ORIGIN=https://world.bballstatistics.com              # exact HTTPS origin
# NODE_ENV=production
# Never commit real database credentials or prefix them with VITE_.
